# ============================================================
# LifeTwin AI — environment configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ============================================================

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Postgres (used by docker-compose to create the DB) ---
POSTGRES_USER=lifetwin
POSTGRES_PASSWORD=lifetwin
POSTGRES_DB=lifetwin

# Full URL the backend actually connects with (docker-compose overrides this
# automatically to point at the `postgres` service; set it yourself only
# when running the backend outside Docker).
DATABASE_URL=postgresql+psycopg2://lifetwin:lifetwin@localhost:5432/lifetwin

# --- JWT ---
JWT_SECRET=lFAiVyvu5LnGcGTz2WlMUbNRRFTx5xVZIhybjxV9ErzGQCs2G7fxcTnh5VgkawbPNC3hOifwy0gSxnoDS9v00w
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Gemini (backend only — never exposed to the frontend) ---
GEMINI_API_KEY=

# --- SMTP (for OTP / password-reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lifetwin.ai

# --- Optional: Twilio SMS for SOS notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- OTP behaviour ---
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
